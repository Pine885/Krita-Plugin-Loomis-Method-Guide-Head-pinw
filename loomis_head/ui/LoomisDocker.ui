            <string notr="true">QSlider::groove:horizontal {
    height: 10px;
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 5px;
}
QSlider::sub-page:horizontal {
    background: palette(highlight);
    border-radius: 5px;
}
QSlider::handle:horizontal {
